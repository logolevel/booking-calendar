generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  member
  external
}

enum EventType {
  women
  men
  mixed
  individual
  tech_women
  tech_men
  group
}

enum Gender {
  male
  female
}

model User {
  id          BigInt    @id
  firstName   String
  lastName    String?
  username    String?
  gender      Gender?
  onboardedAt DateTime?
  role        Role      @default(member)
  // Admins assigned from the Mini App by other admins (root stays in ADMIN_ID).
  isAdmin     Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  events      Event[]
}

// Users granted access from outside the group, managed by the admin.
model ExternalAccess {
  telegramId    BigInt   @id
  grantedBy     BigInt
  accessRevoked Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// Simple key-value store for runtime-configurable settings (e.g. maxDaysAhead).
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

// Prime-time perk for a user. Active now when startsAt <= now <= endsAt; an
// expired row simply stops granting perks. Multiple rows = purchase history.
model Subscription {
  id        String   @id @default(uuid())
  userId    BigInt
  startsAt  DateTime
  endsAt    DateTime
  // Length in whole months (1..12); endsAt = startsAt + months.
  months    Int
  // Telegram id of the admin who granted it (manual assignment for now).
  createdBy BigInt
  note      String?
  createdAt DateTime @default(now())

  @@index([userId, endsAt])
}

model Event {
  id             String                  @id @default(uuid())
  type           EventType
  resourceId     Int
  title          String?
  capacity       Int                     @default(6)
  // Admin-created events may stay empty; member events auto-delete when empty.
  allowEmpty     Boolean                 @default(false)
  // Set only for `group` events: organizer contact details and head count.
  organizerName  String?
  organizerPhone String?
  groupSize      Int?
  startsAt       DateTime
  endsAt         DateTime
  createdBy      BigInt
  author       User                    @relation(fields: [createdBy], references: [id])
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt
  participants EventParticipant[]
  waitlist     EventWaitlist[]
  logs         EventParticipationLog[]
  chatMessages EventChatMessage[]

  // A Postgres EXCLUDE constraint ("Event_no_overlap") forbids two events on the
  // same resourceId from overlapping in time. It cannot be expressed in Prisma
  // schema, so it lives in migration 20260605000000_event_no_overlap and must be
  // kept in sync manually. Violations surface as SQLSTATE 23P01 -> 409 Conflict.
  @@index([startsAt])
}

// Reusable outside guest, kept apart from the group user directory.
model Guest {
  id           String             @id @default(uuid())
  firstName    String
  lastName     String
  gender       Gender
  createdBy    BigInt
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  participants EventParticipant[]

  @@index([lastName, firstName])
}

// A participant is either an app user (userId) or a reusable guest (guestId).
// addedByUserId records who added them (self or a +1).
model EventParticipant {
  id            String   @id @default(uuid())
  eventId       String
  userId        BigInt?
  guestId       String?
  addedByUserId BigInt
  // Visual-only beach-volley pairing: two participants sharing the same pairId
  // form a pair. Has no effect on capacity, quota or any event logic.
  pairId        String?
  joinedAt      DateTime @default(now())
  event         Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  guest         Guest?   @relation(fields: [guestId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@unique([eventId, guestId])
  @@index([eventId])
  @@index([eventId, pairId])
}

// FIFO waiting list; a user gets auto-promoted when a slot frees up.
model EventWaitlist {
  id        String   @id @default(uuid())
  eventId   String
  userId    BigInt
  createdAt DateTime @default(now())
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([eventId, createdAt])
}

// Audit trail of who did what to whom (join/add/leave/remove/promoted).
model EventParticipationLog {
  id              String   @id @default(uuid())
  eventId         String
  actorUserId     BigInt
  targetUserId    BigInt?
  targetGuestName String?
  action          String
  at              DateTime @default(now())
  event           Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, at])
}

// The bot's "main" message about an event in a recipient's private chat. Edited
// in place to keep the latest event state; change notices are sent as replies
// to this message. One row per (event, recipient).
model EventChatMessage {
  id        String   @id @default(uuid())
  eventId   String
  userId    BigInt
  messageId Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([eventId])
}
