generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  admin
  member
  external
}

enum EventType {
  women
  men
  mixed
  individual
  tech_women
  tech_men
  group
}

enum Gender {
  male
  female
}

model User {
  id          BigInt    @id
  firstName   String
  lastName    String?
  username    String?
  gender      Gender?
  onboardedAt DateTime?
  role        Role      @default(member)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  events      Event[]
}

// Users granted access from outside the group, managed by the admin.
model ExternalAccess {
  telegramId    BigInt   @id
  grantedBy     BigInt
  accessRevoked Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// Simple key-value store for runtime-configurable settings (e.g. maxDaysAhead).
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model Event {
  id             String                  @id @default(uuid())
  type           EventType
  resourceId     Int
  title          String?
  capacity       Int                     @default(6)
  // Admin-created events may stay empty; member events auto-delete when empty.
  allowEmpty     Boolean                 @default(false)
  // Set only for `group` events: organizer contact details and head count.
  organizerName  String?
  organizerPhone String?
  groupSize      Int?
  startsAt       DateTime
  endsAt         DateTime
  createdBy      BigInt
  author       User                    @relation(fields: [createdBy], references: [id])
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt
  participants EventParticipant[]
  waitlist     EventWaitlist[]
  logs         EventParticipationLog[]

  @@index([startsAt])
}

// Reusable outside guest, kept apart from the group user directory.
model Guest {
  id           String             @id @default(uuid())
  firstName    String
  lastName     String
  gender       Gender
  createdBy    BigInt
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  participants EventParticipant[]

  @@index([lastName, firstName])
}

// A participant is either an app user (userId) or a reusable guest (guestId).
// addedByUserId records who added them (self or a +1).
model EventParticipant {
  id            String   @id @default(uuid())
  eventId       String
  userId        BigInt?
  guestId       String?
  addedByUserId BigInt
  joinedAt      DateTime @default(now())
  event         Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  guest         Guest?   @relation(fields: [guestId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@unique([eventId, guestId])
  @@index([eventId])
}

// FIFO waiting list; a user gets auto-promoted when a slot frees up.
model EventWaitlist {
  id        String   @id @default(uuid())
  eventId   String
  userId    BigInt
  createdAt DateTime @default(now())
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([eventId, createdAt])
}

// Audit trail of who did what to whom (join/add/leave/remove/promoted).
model EventParticipationLog {
  id              String   @id @default(uuid())
  eventId         String
  actorUserId     BigInt
  targetUserId    BigInt?
  targetGuestName String?
  action          String
  at              DateTime @default(now())
  event           Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId, at])
}
