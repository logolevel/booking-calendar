# Telegram bot token from @BotFather
BOT_TOKEN=

# Telegram user id of the admin
ADMIN_ID=

# Numeric id of the supergroup whose members get access (e.g. -1001234567890).
# Send /chatid to the bot inside the group to obtain it.
GROUP_CHAT_ID=

# Public URL where this service is reachable, used to register the webhook.
# The webhook endpoint is <WEBHOOK_URL>; Telegram will POST updates there.
WEBHOOK_URL=https://booking-calendar-production.up.railway.app/calendar-webhook

# Postgres connection string (Railway provides this automatically)
DATABASE_URL=postgresql://user:password@localhost:5432/tg_calendar?schema=public

# Provided by Railway at runtime; local fallback only
PORT=3000
NODE_ENV=development
